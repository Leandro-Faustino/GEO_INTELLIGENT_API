# Copie para .env antes de usar docker compose localmente.
# Não use estes valores em produção.

POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
APP_HOST_PORT=3000
ENGINE_HOST_PORT=8000

POSTGRES_USER=geolead
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_DB=geolead

MONGO_INITDB_ROOT_USERNAME=geolead
MONGO_INITDB_ROOT_PASSWORD=local-mongo-password-change-me
MONGO_INITDB_DATABASE=geolead

JWT_SECRET=local-jwt-secret-change-me-with-at-least-32-chars
INTERNAL_API_KEY=local-internal-api-key-change-me-32
MOTOR_URL=http://engine:8000
MOTOR_API_KEY=local-internal-api-key-change-me-32
MOTOR_TIMEOUT_MS=10000
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=api
EMBEDDINGS_MODEL=text-embedding-3-small
HOOKS_LLM_ENABLED=false
RETRAIN_MODE=inline
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CNPJ_API_URL=
CNPJ_API_KEY=
ADMIN_EMAIL=admin@example.com
# Hash scrypt de exemplo para a senha local-admin-password-change-me.
# Troque em qualquer ambiente compartilhado ou produtivo.
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$6c6f63616c2d61646d696e2d73616c742d6368616e67652d6d65$9944412e8f9de642dfb9722f1d3c8edf9c5ce83ebc02d770109d25db32e28caec9d51b313e87b34c32f738f7de523cab4820a3ebf073df28bb9ee49d85c30dd9

METRICS_ENABLED=true
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=local-grafana-password-change-me
JAEGER_UI_HOST_PORT=16686
OTLP_HTTP_HOST_PORT=4318
