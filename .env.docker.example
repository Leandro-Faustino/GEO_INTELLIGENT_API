# Copie para .env antes de usar docker compose localmente.
# Não use estes valores em produção.

POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
APP_HOST_PORT=3000

POSTGRES_USER=geolead
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_DB=geolead

MONGO_INITDB_ROOT_USERNAME=geolead
MONGO_INITDB_ROOT_PASSWORD=local-mongo-password-change-me
MONGO_INITDB_DATABASE=geolead

JWT_SECRET=local-jwt-secret-change-me-with-at-least-32-chars
