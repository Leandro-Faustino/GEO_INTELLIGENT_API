{
  "name": "api-base",
  "version": "0.1.0",
  "description": "Base segura de API Fastify + TypeScript",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx test/owasp.security.test.ts",
    "test:security": "node --import tsx test/owasp.security.test.ts",
    "test:unit": "node --import tsx --test test/unit/**/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/env": "^5.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/mongodb": "^10.0.0",
    "@fastify/postgres": "^6.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/redis": "^7.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@fastify/under-pressure": "^9.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sinclair/typebox": "^0.34.49",
    "close-with-grace": "^2.1.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "mongodb": "^7.2.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.4"
  }
}
