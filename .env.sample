# ─────────────────────────────────────────────────────────────
# .env.sample — modelo de configuração (12-factor app)
# Copie para .env e preencha. NUNCA comite o .env real.
# ─────────────────────────────────────────────────────────────

# Ambiente de execução: development | test | production
NODE_ENV=development

# Endereço e porta de escuta
HOST=0.0.0.0
PORT=3000

# Nível de log do Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Limite de corpo da requisição em bytes (default 1 MiB)
BODY_LIMIT=1048576

# CORS: lista de origens permitidas separadas por vírgula.
# Vazio = nenhuma origem de browser permitida (mais seguro por padrão).
# Ex.: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGIN=

# Rate limit: máximo de requisições por janela de tempo, por IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Login tem limite próprio por ser alvo comum de brute-force
LOGIN_RATE_LIMIT_MAX=5

# JWT: use um segredo real, aleatório e com pelo menos 32 caracteres.
# Nunca use este placeholder em produção.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=15m

# Persistência: false mantém repositórios em memória.
DB_ENABLED=false

# PostgreSQL: dados relacionais/transacionais.
# POSTGRES_URL tem prioridade; DATABASE_URL fica como compatibilidade.
# Ex.: postgres://geolead:geolead@localhost:5432/geolead
POSTGRES_URL=
POSTGRES_POOL_MAX=10
POSTGRES_SSL=false
DATABASE_URL=

# MongoDB: entidades-alvo e territórios com índice geoespacial.
# Ex.: mongodb://geolead:geolead@localhost:27017/geolead?authSource=admin
MONGO_URL=

# Redis: cache-aside. Vazio usa cache em memória.
# Ex.: redis://localhost:6379
REDIS_URL=
CACHE_TTL_SECONDS=3600

# Observabilidade
METRICS_ENABLED=true
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Documentação OpenAPI em /docs
SWAGGER_ENABLED=true

# Motor Python de inteligência
ENVIRONMENT=development
ENGINE_HOST_PORT=8000
INTERNAL_API_KEY=change-me-with-at-least-32-characters
MODEL_VERSION=0.1.0
MOTOR_URL=http://localhost:8000
MOTOR_API_KEY=change-me-with-at-least-32-characters
MOTOR_TIMEOUT_MS=10000

# Fases opcionais 7/8 do motor Python.
# Mantidas desligadas por padrão para evitar custo de libs/modelos pesados.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=api
EMBEDDINGS_MODEL=text-embedding-3-small
HOOKS_LLM_ENABLED=false

# Re-treino assíncrono do motor: inline | celery.
# inline é o padrão leve; celery exige broker/worker.
RETRAIN_MODE=inline
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Endpoint de busca em massa por CNAE+município (custom backend).
# Vazio mantém o mock realista do piloto.
CNPJ_API_URL=
CNPJ_API_KEY=

# Enriquecimento individual por CNPJ:
#   ReceitaWS: fonte primária (dados cadastrais RF — situação, sócios, email, capital)
#   Ex.: https://www.receitaws.com.br
RECEITAWS_BASE_URL=
#   BrasilAPI: complementa (CNAEs formatados, flags Simples/MEI, quadro societário detalhado)
#   Ex.: https://brasilapi.com.br
BRASILAPI_BASE_URL=

# API pública do IBGE. Vazio mantém o mock local.
# Ex.: https://servicodados.ibge.gov.br/api
IBGE_BASE_URL=

# Dataset estático de IDH municipal. Vazio mantém o IBGE real sem campo idh.
IDH_MUNICIPAL_DATASET_PATH=

# Geocoder Nominatim/OpenStreetMap. Vazio mantém o mock local.
# Use um User-Agent identificável com contato real e respeite 1 req/s.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=
NOMINATIM_THROTTLE_MS=1000

# GeoJSON local com malhas de setores censitários do IBGE recortadas por área.
# Vazio mantém setorCensitario=null no Geocoder real.
SETORES_CENSITARIOS_GEOJSON_PATH=

# Usuário admin em produção. Gere o hash scrypt fora do código e guarde
# o valor real em secrets do ambiente de deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
