# ─────────────────────────────────────────────────────────────
# .env.sample — modelo de configuração (12-factor app)
# Copie para .env e preencha. NUNCA comite o .env real.
# ─────────────────────────────────────────────────────────────

# Ambiente de execução: development | test | production
NODE_ENV=development

# Endereço e porta de escuta
HOST=0.0.0.0
PORT=3000

# Nível de log do Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Limite de corpo da requisição em bytes (default 1 MiB)
BODY_LIMIT=1048576

# CORS: lista de origens permitidas separadas por vírgula.
# Vazio = nenhuma origem de browser permitida (mais seguro por padrão).
# Ex.: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGIN=

# Rate limit: máximo de requisições por janela de tempo, por IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Login tem limite próprio por ser alvo comum de brute-force
LOGIN_RATE_LIMIT_MAX=5

# JWT: use um segredo real, aleatório e com pelo menos 32 caracteres.
# Nunca use este placeholder em produção.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=15m

# Persistência: false mantém repositórios em memória.
DB_ENABLED=false

# PostgreSQL: dados relacionais/transacionais.
# POSTGRES_URL tem prioridade; DATABASE_URL fica como compatibilidade.
# Ex.: postgres://geolead:geolead@localhost:5432/geolead
POSTGRES_URL=
POSTGRES_POOL_MAX=10
POSTGRES_SSL=false
DATABASE_URL=

# MongoDB: entidades-alvo e territórios com índice geoespacial.
# Ex.: mongodb://geolead:geolead@localhost:27017/geolead?authSource=admin
MONGO_URL=

# Redis: cache-aside. Vazio usa cache em memória.
# Ex.: redis://localhost:6379
REDIS_URL=
CACHE_TTL_SECONDS=3600

# Documentação OpenAPI em /docs
SWAGGER_ENABLED=true
